# Local dev only (outside Docker Compose). Copy to .env and fill in real values.
# When running via `docker-compose up`, the api service gets DATABASE_URL/JWT_SECRET/REDIS_URL
# injected directly (see ../docker-compose.yml + ../.env) and this file is not used.
DATABASE_URL=postgresql://tea_user:your_strong_password_here@localhost:5432/tea_db
JWT_SECRET=your_long_random_secret_here
JWT_EXPIRES_IN=7d
REDIS_URL=redis://localhost:6379
PORT=3000
