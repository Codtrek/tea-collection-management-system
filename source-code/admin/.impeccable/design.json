  "narrative": {
    "northStar": "The Factory Ledger",
    "overview": "The portal is the factory's record book. It's calm, exact and trustworthy: a page of white surfaces on a faintly green paper (#f8fbf9). Figures are set in tabular numbers so columns of kilograms and rupees line up. The factory's green is its ink. Nothing on the page is decorative. Each number is another record's own figure and opens that record, and each colour means something.\n\nThe pages are dense but quiet, because staff come to work, not to browse. On every screen the work comes first (\"what needs me\"), then the figures that show how the day and the month are going. Colour is kept for meaning: green for actions and progress, amber for something due, red for something blocked or wrong. Each is paired with a word or an icon, never alone. The look rejects marketing dashboards: no hero banners, no gradients behind content, no \"revenue\" tiles for figures the factory doesn't record.",
    "keyCharacteristics": [
      "White surfaces on a faintly green page; thin warm-grey borders and dividers.",
      "One solid green primary action per view; everything else is quiet.",
      "Tabular figures everywhere; record IDs in a mono face.",
      "Labelled rows over hero numbers; every figure opens its records.",
      "Flat at rest; shadows lift only on hover, focus and floating layers."
    ],
    "rules": [
      {
        "name": "The Pair Rule",
        "body": "A status colour never appears alone. It always comes with its pair (bg and fg) and with a word or an icon: \"Blocked\", \"▼ down 69.4%\".",
        "section": "colors"
      },
      {
        "name": "The One Green Button Rule",
        "body": "One primary action per view, and it is Ledger Green. Destructive and irreversible money actions also stay primary green; red means a destructive delete, never \"important\".",
        "section": "colors"
      },
      {
        "name": "The No Raw Hex Rule",
        "body": "Components use tokens only. A new colour is a new token first.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every kilogram, rupee, percentage, count and date is `tabular-nums`, so columns align and values don't jitter as they update.",
        "section": "typography"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "Headings, nav groups and buttons are sentence case. Uppercase is used only for small form-field labels.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Depth is a response to use: hover, focus, or something floating above the page. It is never decoration.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** link every figure to the list that it counts, and make the count equal that list.",
      "**Do** say why a block is empty or blocked, in a sentence.",
      "**Do** pair every status colour with a word or an arrow (▲ up / ▼ down).",
      "**Do** use `formatDate` (`10 Jul 2026`), `formatCurrency` (`Rs. 1,245,600`) and `formatKg` for every figure.",
      "**Do** show skeletons the size of the block they replace, and respect `prefers-reduced-motion`."
    ],
    "donts": [
      "**Don't** use raw hex, `bg-white`, or a colour without a token.",
      "**Don't** add hero banners, gradients behind content, or decorative illustrations to working screens.",
      "**Don't** show revenue, profit or any figure the factory does not record.",
      "**Don't** put Approve or Decline buttons on a dashboard or summary; decisions happen on their own page.",
      "**Don't** grey out what a role can't do; hide it.",
      "**Don't** use red for irreversible money actions; those are primary green with a re-type confirmation."
    ]
  }
}