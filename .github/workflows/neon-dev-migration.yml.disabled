
name: Neon Dev Migrations

on:
  push:
    branches:
      - dev
  workflow_dispatch:

concurrency:
  group: neon-dev-migrations
  cancel-in-progress: false

permissions:
  contents: read

jobs:
  migrate:
    name: migrate-neon-dev
    runs-on: ubuntu-latest
    timeout-minutes: 15

    defaults:
      run:
        working-directory: source-code/backend

    steps:
      - name: Checkout dev branch
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm
          cache-dependency-path: source-code/backend/package-lock.json

      - name: Install dependencies
        run: npm ci

      - name: Run migrations on shared Neon Dev
        env:
          DATABASE_URL_DIRECT: ${{ secrets.NEON_DEV_DATABASE_URL }}
        run: |
          if [ -z "$DATABASE_URL_DIRECT" ]; then
            echo "::error::NEON_DEV_DATABASE_URL is not configured"
            exit 1
          fi
          npm run migration:run

      - name: Report successful migration
        if: success()
        run: |
          echo "### Neon Dev migrations succeeded" >> "$GITHUB_STEP_SUMMARY"
